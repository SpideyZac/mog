{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpideyZac/mog/blob/master/docs/plugin-protocol.schema.json",
  "title": "mog plugin protocol 2",
  "description": "The params and results of the JSON-RPC messages between mog and a plugin. See docs/plugins.md. Offsets count chars, lines and columns start at 0.",
  "$defs": {
    "offset": { "type": "integer", "minimum": 0 },
    "path": { "type": ["string", "null"], "description": "An absolute path, or relative to the project. null means the focused file." },
    "color": { "type": ["string", "null"], "description": "A theme color name like green or a hex code like #ff5ccd." },
    "language": { "type": ["string", "null"], "description": "The file extension, like rs." },
    "change": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "$ref": "#/$defs/offset" },
        "end": { "$ref": "#/$defs/offset" },
        "text": { "type": "string" }
      }
    },
    "fileEdit": {
      "type": "object",
      "required": ["changes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "version": { "type": ["integer", "null"], "minimum": 0, "description": "Refused if the file is at another version." },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      }
    },
    "selection": {
      "type": "object",
      "required": ["anchor", "head"],
      "properties": {
        "anchor": { "$ref": "#/$defs/offset" },
        "head": { "$ref": "#/$defs/offset" }
      }
    },
    "command": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^\\s:]+$" },
        "title": { "type": "string" },
        "keys": { "type": "array", "items": { "type": "string" } },
        "menu": { "type": "boolean" }
      }
    },
    "languages": {
      "oneOf": [
        { "const": true },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "action": {
      "oneOf": [
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "status" }, "text": { "type": "string" } } },
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "notify" }, "text": { "type": "string" }, "level": { "enum": ["info", "warning", "error"] } } },
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "insert" }, "text": { "type": "string" } } },
        { "allOf": [{ "$ref": "#/$defs/fileEdit" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "edit" } } }] },
        { "type": "object", "required": ["type", "edits"], "properties": { "type": { "const": "workspace_edit" }, "edits": { "type": "array", "items": { "$ref": "#/$defs/fileEdit" } } } },
        { "type": "object", "required": ["type", "path"], "properties": { "type": { "const": "open" }, "path": { "type": "string" }, "line": { "$ref": "#/$defs/offset" }, "column": { "$ref": "#/$defs/offset" } } },
        { "type": "object", "required": ["type", "selections"], "properties": { "type": { "const": "select" }, "path": { "$ref": "#/$defs/path" }, "selections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selection" } } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "save" }, "path": { "$ref": "#/$defs/path" } } },
        { "type": "object", "required": ["type", "name"], "properties": { "type": { "const": "command" }, "name": { "type": "string" }, "args": {} } },
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "output" }, "title": { "type": "string" }, "text": { "type": "string" } } }
      ]
    },
    "actions": {
      "type": "object",
      "properties": { "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } } }
    },
    "context": {
      "type": "object",
      "properties": {
        "root": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "language": { "$ref": "#/$defs/language" },
        "text": { "type": ["string", "null"], "description": "null for files over 8 MB." },
        "length": { "$ref": "#/$defs/offset" },
        "version": { "type": "integer" },
        "selection": { "$ref": "#/$defs/selection" },
        "selections": { "type": "array", "items": { "$ref": "#/$defs/selection" } },
        "line": { "$ref": "#/$defs/offset" },
        "column": { "$ref": "#/$defs/offset" },
        "modified": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/offset" },
        "end": { "$ref": "#/$defs/offset" },
        "line": { "$ref": "#/$defs/offset" },
        "column": { "$ref": "#/$defs/offset" },
        "end_line": { "$ref": "#/$defs/offset" },
        "end_column": { "$ref": "#/$defs/offset" },
        "severity": { "enum": ["error", "warning", "info", "hint"] },
        "message": { "type": "string" }
      }
    }
  },
  "type": "object",
  "properties": {
    "initialize": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["protocolVersion", "mogVersion", "root"],
          "properties": {
            "protocolVersion": { "const": 2 },
            "mogVersion": { "type": "string" },
            "root": { "type": "string" },
            "settings": { "type": "object" },
            "capabilities": {
              "type": "object",
              "properties": {
                "events": { "type": "array", "items": { "type": "string" } },
                "requests": { "type": "array", "items": { "type": "string" } },
                "actions": { "type": "array", "items": { "type": "string" } },
                "providers": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "protocolVersion": { "enum": [1, 2] },
            "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
            "events": {
              "type": "array",
              "items": { "enum": ["opened", "closed", "saved", "changed", "selection", "diagnostics", "config_changed", "idle", "task_finished", "git_changed", "before_save"] }
            },
            "providers": {
              "type": "object",
              "properties": {
                "completion": { "$ref": "#/$defs/languages" },
                "hover": { "$ref": "#/$defs/languages" },
                "formatting": { "$ref": "#/$defs/languages" },
                "code_actions": { "$ref": "#/$defs/languages" }
              }
            }
          }
        }
      }
    },
    "command": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["command", "context"],
          "properties": { "command": { "type": "string" }, "args": {}, "context": { "$ref": "#/$defs/context" } }
        },
        "result": { "$ref": "#/$defs/actions" }
      }
    },
    "event": {
      "description": "mog to plugin notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string" },
            "path": { "type": ["string", "null"] },
            "language": { "$ref": "#/$defs/language" },
            "version": { "type": "integer" },
            "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
            "text": { "type": "string" },
            "selections": { "type": "array", "items": { "$ref": "#/$defs/selection" } }
          }
        }
      }
    },
    "before_save": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "path": { "type": "string" }, "language": { "$ref": "#/$defs/language" }, "version": { "type": "integer" }, "text": { "type": "string" } }
        },
        "result": {
          "type": "object",
          "properties": { "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } } }
        }
      }
    },
    "provide/completion": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": { "type": "string" },
                  "insert": { "type": "string" },
                  "detail": { "type": "string" },
                  "filter": { "type": "string" },
                  "kind": { "enum": ["function", "method", "variable", "value", "field", "property", "type", "class", "struct", "interface", "module", "namespace", "keyword", "constant"] }
                }
              }
            }
          }
        }
      }
    },
    "provide/hover": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": { "result": { "type": "object", "properties": { "text": { "type": "string" } } } }
    },
    "provide/formatting": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "result": { "type": "object", "properties": { "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } } } }
      }
    },
    "provide/code_actions": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": { "allOf": [{ "$ref": "#/$defs/actions" }, { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" } } }] }
            }
          }
        }
      }
    },
    "$/cancelRequest": {
      "description": "mog to plugin notification, mog gave up on the request with this id.",
      "type": "object",
      "properties": { "params": { "type": "object", "properties": { "id": {} } } }
    },
    "actions": {
      "description": "plugin to mog notification or request.",
      "type": "object",
      "properties": { "params": { "$ref": "#/$defs/actions" } }
    },
    "segment": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "text": { "type": "string" }, "color": { "$ref": "#/$defs/color" }, "command": { "type": ["string", "null"] }, "id": { "type": "string" } }
        }
      }
    },
    "progress": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "percentage": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }, "done": { "type": "boolean" } }
        }
      }
    },
    "diagnostics": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["diagnostics"],
          "properties": { "path": { "$ref": "#/$defs/path" }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } } }
        }
      }
    },
    "decorations": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["decorations"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "decorations": {
              "type": "array",
              "items": { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/offset" }, "text": { "type": "string" }, "color": { "$ref": "#/$defs/color" } } }
            }
          }
        }
      }
    },
    "editor/text": {
      "description": "plugin to mog request.",
      "type": "object",
      "properties": {
        "params": { "type": "object", "properties": { "path": { "$ref": "#/$defs/path" }, "start": { "$ref": "#/$defs/offset" }, "end": { "$ref": "#/$defs/offset" } } },
        "result": { "type": "object", "properties": { "text": { "type": "string" }, "version": { "type": ["integer", "null"] }, "length": { "$ref": "#/$defs/offset" } } }
      }
    },
    "ui/pick": {
      "description": "plugin to mog request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "required": ["label"], "properties": { "label": { "type": "string" }, "detail": { "type": "string" }, "hint": { "type": "string" } } }
                ]
              }
            }
          }
        },
        "result": { "type": ["object", "null"], "properties": { "index": { "type": "integer" }, "item": { "type": "string" } } }
      }
    }
  }
}
