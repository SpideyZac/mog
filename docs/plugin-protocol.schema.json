{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpideyZac/mog/blob/master/docs/plugin-protocol.schema.json",
  "title": "mog plugin protocol 2",
  "description": "The params and results of the JSON-RPC messages between mog and a plugin. See docs/plugins.md. Offsets count chars, lines and columns start at 0.",
  "$defs": {
    "location": {
      "type": "object",
      "required": ["line"],
      "properties": {
        "path": { "type": "string", "description": "relative to the project, the asked about file when left out" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 }
      }
    },
    "locations": {
      "oneOf": [
        { "type": "object", "required": ["locations"], "properties": { "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } } } },
        { "$ref": "#/$defs/location" }
      ]
    },
    "offset": { "type": "integer", "minimum": 0 },
    "path": { "type": ["string", "null"], "description": "An absolute path, or relative to the project. null means the focused file." },
    "color": { "type": ["string", "null"], "description": "A theme color name like green or a hex code like #ff5ccd." },
    "language": { "type": ["string", "null"], "description": "The file extension, like rs." },
    "change": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "$ref": "#/$defs/offset" },
        "end": { "$ref": "#/$defs/offset" },
        "text": { "type": "string" }
      }
    },
    "fileEdit": {
      "type": "object",
      "required": ["changes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "version": { "type": ["integer", "null"], "minimum": 0, "description": "Refused if the file is at another version." },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      }
    },
    "selection": {
      "type": "object",
      "required": ["anchor", "head"],
      "properties": {
        "anchor": { "$ref": "#/$defs/offset" },
        "head": { "$ref": "#/$defs/offset" }
      }
    },
    "command": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^\\s:]+$" },
        "title": { "type": "string" },
        "keys": { "type": "array", "items": { "type": "string" } },
        "menu": { "type": "boolean" }
      }
    },
    "languages": {
      "oneOf": [
        { "const": true },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "action": {
      "oneOf": [
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "status" }, "text": { "type": "string" } } },
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "notify" }, "text": { "type": "string" }, "level": { "enum": ["info", "warning", "error"] } } },
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "insert" }, "text": { "type": "string" } } },
        { "allOf": [{ "$ref": "#/$defs/fileEdit" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "edit" } } }] },
        { "type": "object", "required": ["type", "edits"], "properties": { "type": { "const": "workspace_edit" }, "edits": { "type": "array", "items": { "$ref": "#/$defs/fileEdit" } } } },
        { "type": "object", "required": ["type", "path"], "properties": { "type": { "const": "open" }, "path": { "type": "string" }, "line": { "$ref": "#/$defs/offset" }, "column": { "$ref": "#/$defs/offset" } } },
        { "type": "object", "required": ["type", "selections"], "properties": { "type": { "const": "select" }, "path": { "$ref": "#/$defs/path" }, "selections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selection" } } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "save" }, "path": { "$ref": "#/$defs/path" } } },
        { "type": "object", "required": ["type", "name"], "properties": { "type": { "const": "command" }, "name": { "type": "string" }, "args": {} } },
        { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "output" }, "title": { "type": "string" }, "text": { "type": "string" } } }
      ]
    },
    "actions": {
      "type": "object",
      "properties": { "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } } }
    },
    "context": {
      "type": "object",
      "properties": {
        "root": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "language": { "$ref": "#/$defs/language" },
        "text": { "type": ["string", "null"], "description": "null for files over 8 MB." },
        "length": { "$ref": "#/$defs/offset" },
        "version": { "type": "integer" },
        "selection": { "$ref": "#/$defs/selection" },
        "selections": { "type": "array", "items": { "$ref": "#/$defs/selection" } },
        "line": { "$ref": "#/$defs/offset" },
        "column": { "$ref": "#/$defs/offset" },
        "modified": { "type": "boolean" }
      }
    },
    "span": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "fg": { "$ref": "#/$defs/color" },
            "bg": { "$ref": "#/$defs/color" },
            "bold": { "type": "boolean" },
            "italic": { "type": "boolean" },
            "underline": { "type": "boolean" }
          }
        }
      ]
    },
    "row": {
      "description": "One row of a widget, a string or a list of spans.",
      "oneOf": [{ "$ref": "#/$defs/span" }, { "type": "array", "items": { "$ref": "#/$defs/span" } }]
    },
    "capture": {
      "type": "object",
      "properties": {
        "keys": {
          "description": "\"all\", a list of keys like \"esc\" or \"shift+g\", or null for none.",
          "oneOf": [{ "const": "all" }, { "type": "array", "items": { "type": "string" } }, { "type": "null" }]
        },
        "except": { "type": "array", "items": { "type": "string" }, "description": "Keys left alone when keys is all." }
      }
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/offset" },
        "end": { "$ref": "#/$defs/offset" },
        "line": { "$ref": "#/$defs/offset" },
        "column": { "$ref": "#/$defs/offset" },
        "end_line": { "$ref": "#/$defs/offset" },
        "end_column": { "$ref": "#/$defs/offset" },
        "severity": { "enum": ["error", "warning", "info", "hint"] },
        "message": { "type": "string" }
      }
    }
  },
  "type": "object",
  "properties": {
    "initialize": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["protocolVersion", "mogVersion", "root"],
          "properties": {
            "protocolVersion": { "const": 2 },
            "mogVersion": { "type": "string" },
            "root": { "type": "string" },
            "settings": { "type": "object" },
            "capabilities": {
              "type": "object",
              "properties": {
                "events": { "type": "array", "items": { "type": "string" } },
                "requests": { "type": "array", "items": { "type": "string" } },
                "notifications": { "type": "array", "items": { "type": "string" } },
                "actions": { "type": "array", "items": { "type": "string" } },
                "providers": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "protocolVersion": { "enum": [1, 2] },
            "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
            "events": {
              "type": "array",
              "items": { "enum": ["opened", "closed", "saved", "changed", "selection", "diagnostics", "config_changed", "idle", "task_finished", "git_changed", "before_save"] }
            },
            "providers": {
              "type": "object",
              "properties": {
                "completion": { "$ref": "#/$defs/languages" },
                "hover": { "$ref": "#/$defs/languages" },
                "formatting": { "$ref": "#/$defs/languages" },
                "code_actions": { "$ref": "#/$defs/languages" },
                "definition": { "$ref": "#/$defs/languages" },
                "references": { "$ref": "#/$defs/languages" },
                "symbols": { "$ref": "#/$defs/languages" },
                "diagnostics": { "$ref": "#/$defs/languages" },
                "tasks": { "$ref": "#/$defs/languages" }
              }
            }
          }
        }
      }
    },
    "command": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["command", "context"],
          "properties": { "command": { "type": "string" }, "args": {}, "context": { "$ref": "#/$defs/context" } }
        },
        "result": { "$ref": "#/$defs/actions" }
      }
    },
    "event": {
      "description": "mog to plugin notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string" },
            "path": { "type": ["string", "null"] },
            "language": { "$ref": "#/$defs/language" },
            "version": { "type": "integer" },
            "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
            "text": { "type": "string" },
            "selections": { "type": "array", "items": { "$ref": "#/$defs/selection" } }
          }
        }
      }
    },
    "before_save": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "path": { "type": "string" }, "language": { "$ref": "#/$defs/language" }, "version": { "type": "integer" }, "text": { "type": "string" } }
        },
        "result": {
          "type": "object",
          "properties": { "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } } }
        }
      }
    },
    "provide/completion": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": { "type": "string" },
                  "insert": { "type": "string" },
                  "detail": { "type": "string" },
                  "filter": { "type": "string" },
                  "kind": { "enum": ["function", "method", "variable", "value", "field", "property", "type", "class", "struct", "interface", "module", "namespace", "keyword", "constant"] }
                }
              }
            }
          }
        }
      }
    },
    "provide/hover": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": { "result": { "type": "object", "properties": { "text": { "type": "string" } } } }
    },
    "provide/formatting": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "result": { "type": "object", "properties": { "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } } } }
      }
    },
    "provide/code_actions": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": { "allOf": [{ "$ref": "#/$defs/actions" }, { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" } } }] }
            }
          }
        }
      }
    },
    "provide/definition": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": { "result": { "$ref": "#/$defs/locations" } }
    },
    "provide/references": {
      "description": "mog to plugin request.",
      "type": "object",
      "properties": { "result": { "$ref": "#/$defs/locations" } }
    },
    "provide/symbols": {
      "description": "mog to plugin request. query is null for the symbols of one file.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "path": { "type": ["string", "null"] }, "language": { "$ref": "#/$defs/language" }, "query": { "type": ["string", "null"] } }
        },
        "result": {
          "type": "object",
          "properties": {
            "symbols": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "kind": { "type": "string" },
                  "detail": { "type": "string" },
                  "path": { "type": "string" },
                  "line": { "type": "integer", "minimum": 0 },
                  "column": { "type": "integer", "minimum": 0 },
                  "depth": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "provide/diagnostics": {
      "description": "mog to plugin request, sent when typing pauses for each open file that changed.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "path": { "type": "string" }, "language": { "$ref": "#/$defs/language" }, "version": { "type": "integer" }, "text": { "type": "string" } }
        },
        "result": { "type": "object", "properties": { "diagnostics": { "type": "array", "items": { "type": "object" } } } }
      }
    },
    "provide/tasks": {
      "description": "mog to plugin request, sent when the task list opens.",
      "type": "object",
      "properties": {
        "params": { "type": "object", "properties": { "root": { "type": "string" } } },
        "result": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "command"],
                "properties": { "name": { "type": "string" }, "command": { "type": "string" }, "cwd": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "$/cancelRequest": {
      "description": "mog to plugin notification, mog gave up on the request with this id.",
      "type": "object",
      "properties": { "params": { "type": "object", "properties": { "id": {} } } }
    },
    "actions": {
      "description": "plugin to mog notification or request.",
      "type": "object",
      "properties": { "params": { "$ref": "#/$defs/actions" } }
    },
    "segment": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "text": { "type": "string" }, "color": { "$ref": "#/$defs/color" }, "command": { "type": ["string", "null"] }, "id": { "type": "string" } }
        }
      }
    },
    "progress": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "percentage": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }, "done": { "type": "boolean" } }
        }
      }
    },
    "diagnostics": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["diagnostics"],
          "properties": { "path": { "$ref": "#/$defs/path" }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } } }
        }
      }
    },
    "decorations": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "required": ["decorations"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "decorations": {
              "type": "array",
              "items": { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/offset" }, "text": { "type": "string" }, "color": { "$ref": "#/$defs/color" } } }
            }
          }
        }
      }
    },
    "draw": {
      "description": "plugin to mog notification, puts a widget on the screen. No lines or frames removes it.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "lines": { "type": "array", "items": { "$ref": "#/$defs/row" } },
            "frames": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/row" } } },
            "fps": { "type": "number", "minimum": 0 },
            "anchor": { "enum": ["top_left", "top_right", "bottom_left", "bottom_right", "center", "cursor", "screen"] },
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "flair": { "type": "boolean", "description": "Hidden with the rest of the flair, true when left out." },
            "transparent": { "type": "boolean" },
            "clickable": { "type": "boolean" },
            "fg": { "$ref": "#/$defs/color" },
            "bg": { "$ref": "#/$defs/color" },
            "z": { "type": "integer" },
            "restart": { "type": "boolean" },
            "motion": {
              "type": "object",
              "properties": { "dx": { "type": "number" }, "dy": { "type": "number" }, "edge": { "enum": ["bounce", "wrap"] } }
            }
          }
        }
      }
    },
    "clear": {
      "description": "plugin to mog notification, removes a widget, or all of them without an id.",
      "type": "object",
      "properties": { "params": { "type": "object", "properties": { "id": { "type": ["string", "null"] } } } }
    },
    "cursor": {
      "description": "plugin to mog notification.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": { "shape": { "enum": ["default", "block", "bar", "underline"] }, "blink": { "type": "boolean" } }
        }
      }
    },
    "capture": {
      "description": "plugin to mog notification, takes keys before the editor.",
      "type": "object",
      "properties": { "params": { "$ref": "#/$defs/capture" } }
    },
    "timer": {
      "description": "plugin to mog notification, sends the timer event every so many milliseconds. 0 stops it.",
      "type": "object",
      "properties": {
        "params": { "type": "object", "properties": { "id": { "type": "string" }, "every": { "type": "integer", "minimum": 0 } } }
      }
    },
    "key": {
      "description": "mog to plugin request for a key the plugin captured.",
      "type": "object",
      "properties": {
        "params": {
          "allOf": [{ "$ref": "#/$defs/context" }],
          "properties": { "key": { "type": "string" }, "char": { "type": ["string", "null"] } }
        },
        "result": {
          "type": "object",
          "properties": {
            "handled": { "type": "boolean", "description": "false hands the key to the editor, true when left out." },
            "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
            "capture": { "$ref": "#/$defs/capture" }
          }
        }
      }
    },
    "ui/layout": {
      "description": "plugin to mog request.",
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "screen": { "type": "object" },
            "editor": { "type": "object" },
            "split": { "type": ["object", "null"] },
            "status": { "type": "object" },
            "cursor": { "type": ["object", "null"] },
            "flair": { "type": "boolean" },
            "reduced_motion": { "type": "boolean" },
            "theme": { "type": "string" }
          }
        }
      }
    },
    "editor/text": {
      "description": "plugin to mog request.",
      "type": "object",
      "properties": {
        "params": { "type": "object", "properties": { "path": { "$ref": "#/$defs/path" }, "start": { "$ref": "#/$defs/offset" }, "end": { "$ref": "#/$defs/offset" } } },
        "result": { "type": "object", "properties": { "text": { "type": "string" }, "version": { "type": ["integer", "null"] }, "length": { "$ref": "#/$defs/offset" } } }
      }
    },
    "ui/pick": {
      "description": "plugin to mog request.",
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "required": ["label"], "properties": { "label": { "type": "string" }, "detail": { "type": "string" }, "hint": { "type": "string" } } }
                ]
              }
            }
          }
        },
        "result": { "type": ["object", "null"], "properties": { "index": { "type": "integer" }, "item": { "type": "string" } } }
      }
    }
  }
}
